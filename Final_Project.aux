\newlabel{fig:compare_window_plot}{{5}{17}{\textbf {Comparison of Spectral Density Estimates.} This figure displays the estimated spectral densities using 3 different taper windows across 3 segment lengths (L = 256, 512, 1024). The shorter segments appear smoother, and the three windows produce similar estimates}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces This table displays the KL divergence of each of the taper window method with various segment length and the true spectral density found from our simulation study. Based on this result, Hanning window with length 256 seems to be outperforming all other windows and lengths.}}{17}{table.1}\protected@file@percent }
\newlabel{window_comp_kl}{{1}{17}{This table displays the KL divergence of each of the taper window method with various segment length and the true spectral density found from our simulation study. Based on this result, Hanning window with length 256 seems to be outperforming all other windows and lengths}{table.1}{}}

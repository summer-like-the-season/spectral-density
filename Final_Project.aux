\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Simulation Study: ARMA-Based Spectral Approximation of a Stationary Process}{6}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {ACF and PACF of the simulated series.} The simulated series are stationary, with exponential decay in ACF and two statistically significant spikes in PACF plot, which allows us to fit an AR(2) model to this series.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:bc_acf}{{1}{7}{\textbf {ACF and PACF of the simulated series.} The simulated series are stationary, with exponential decay in ACF and two statistically significant spikes in PACF plot, which allows us to fit an AR(2) model to this series}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {True Spectral Density and $AR(2)$ Spectral Density.} The estimated spectral density obtained from fitting $AR(2)$ model on the simulated process is visually close to the true spectral density.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:ar2_vs_true}{{2}{8}{\textbf {True Spectral Density and $AR(2)$ Spectral Density.} The estimated spectral density obtained from fitting $AR(2)$ model on the simulated process is visually close to the true spectral density}{figure.2}{}}
\citation{brockwelldavis2016}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Residuals of the $AR(2)$ model.} As observed from the ACF plot, the residuals seem to resemble white noise, and from the histogram, the residuals look normally distributed as well.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:resid_distr}{{3}{9}{\textbf {Residuals of the $AR(2)$ model.} As observed from the ACF plot, the residuals seem to resemble white noise, and from the histogram, the residuals look normally distributed as well}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {KL divergence across different models.} KL divergence between the true $AR(2)$ spectral density and various AR, MA, and ARMA models. Finite-order MA models and low order AR($p$) and $ARMA(p,1)$ ($p=1)$ models exhibit large divergence due to misspecification, whereas AR($p$) and $ARMA(p,q)$ with $p \geq 2$ models achieve near-zero divergence and successfully recover the underlying spectral structure. }}{10}{figure.4}\protected@file@percent }
\newlabel{fig:models_kl_error}{{4}{10}{\textbf {KL divergence across different models.} KL divergence between the true $AR(2)$ spectral density and various AR, MA, and ARMA models. Finite-order MA models and low order AR($p$) and $ARMA(p,1)$ ($p=1)$ models exhibit large divergence due to misspecification, whereas AR($p$) and $ARMA(p,q)$ with $p \geq 2$ models achieve near-zero divergence and successfully recover the underlying spectral structure}{figure.4}{}}
